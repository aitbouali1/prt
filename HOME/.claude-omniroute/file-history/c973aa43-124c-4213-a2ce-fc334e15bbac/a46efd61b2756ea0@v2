import { motion } from "framer-motion"
import {
  Code2,
  Database,
  Table,
  LayoutDashboard,
  Check,
} from "lucide-react"
import SectionHeading from "./SectionHeading"
import { skillGroups } from "../data/skills"
import { container, item } from "../lib/motion"

// Icon map keyed by the `icon` field in data/skills.js.
const icons = {
  python: Code2,
  sql: Database,
  excel: Table,
  powerbi: LayoutDashboard,
}

export default function Skills() {
  return (
    <section id="skills" className="relative py-24 sm:py-32">
      <div className="mx-auto max-w-6xl px-5 sm:px-8">
        <SectionHeading
          eyebrow="Skills"
          title="My Technical Toolkit"
          subtitle="The tools I use to clean, analyze, and visualize data — no inflated proficiency bars, just what I work with."
        />

        <motion.div
          variants={container}
          initial="hidden"
          whileInView="show"
          viewport={{ once: true, amount: 0.15 }}
          className="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4"
        >
          {skillGroups.map((group) => {
            const Icon = icons[group.icon] || Code2
            return (
              <motion.div
                key={group.name}
                variants={item}
                whileHover={{ y: -8 }}
                className="glass-card glow-ring group flex flex-col gap-5 rounded-2xl p-6"
              >
                <div className="flex items-center gap-3">
                  <span className="flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-[color:var(--color-accent)]/20 to-[color:var(--color-accent-2)]/20 text-[color:var(--color-accent-2)] transition-transform group-hover:scale-110">
                    <Icon className="h-6 w-6" />
                  </span>
                  <h3 className="font-[family-name:var(--font-display)] text-lg font-700 text-text">
                    {group.name}
                  </h3>
                </div>

                <ul className="flex flex-col gap-2.5">
                  {group.skills.map((s) => (
                    <li
                      key={s}
                      className="flex items-center gap-2.5 text-sm text-muted transition-colors group-hover:text-text/80"
                    >
                      <Check className="h-3.5 w-3.5 shrink-0 text-[color:var(--color-accent-2)]" />
                      {s}
                    </li>
                  ))}
                </ul>
              </motion.div>
            )
          })}
        </motion.div>
      </div>
    </section>
  )
}
